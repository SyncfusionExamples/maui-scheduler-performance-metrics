<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUISchedulerPerformanceTest.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25">
            <Button Text="Without Appointment" 
                    Clicked="OnButtonClicked"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
            <Button Text="1K Appointments"
                    Clicked="OnButtonClicked"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
            <Button Text="5K Appointments"
                    Clicked="OnButtonClicked"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
            <Button Text="10K Appointments"
                    Clicked="OnButtonClicked"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
            <Button Text="50K Appointments"
                    Clicked="OnButtonClicked"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
            <Button Text="100K Appointments"
                    Clicked="OnButtonClicked"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
            <Button Text="Hierarchical Resources"
                    Clicked="OnButtonClicked"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
